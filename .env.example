# Amazon Bedrock (agente de chat do site)
# Chave de API: console Bedrock > API keys
BEDROCK_API_KEY=sua-chave-bedrock
BEDROCK_REGION=sa-east-1
BEDROCK_CHAT_MODEL=zai.glm-5
# Opcional: sobrescreve a URL derivada da região
# BEDROCK_BASE_URL=https://bedrock-mantle.sa-east-1.api.aws/v1

# DynamoDB
# Em produção, a autenticação vem da Amplify SSR Compute role; não configure
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
DYNAMODB_REGION=sa-east-1
DYNAMODB_TABLE_PREFIX=baxijen-prod
CHAT_RETENTION_DAYS=180
# Somente para testes com DynamoDB Local:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Amazon SES (confirmação da newsletter)
SES_REGION=sa-east-1
NEWSLETTER_FROM_EMAIL=BaXiJen Newsletter <newsletter@baxi.ia.br>
NEXT_PUBLIC_SITE_URL=https://www.baxijen.com.br

# Painel /admin (HTTP Basic; obrigatório e fail-closed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-uma-senha-longa-e-unica

# Google Sheets fallback dos formulários fake-door (opcional)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Email (opcional - para notificações futuras)
# RESEND_API_KEY=sua-chave-resend
# ADMIN_EMAIL=seu-email@exemplo.com
